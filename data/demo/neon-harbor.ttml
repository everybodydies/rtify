        <translations>
          <translation type="replacement" xml:lang="de">
          <text for="L1">Lichter auf dem Wasser, leise summend</text>
          <text for="L2">Jeder Kran tanzt langsam</text>
          <text for="L3">Wir zählen die Schiffe, die nie anlegen</text>
          <text for="L4">Halten die Nacht in offener Hand</text>
          <text for="L5">Neonhafen, trag mich nach Hause</text>
          <text for="L6">Rauschen im Radio</text>
          <text for="L7">Neonhafen, ich bin nicht allein</text>
          <text for="L8">Die Wellen halten den Takt</text>
          </translation>
        </translations>
        <songwriters><songwriter>rtify contributors</songwriter></songwriters>
