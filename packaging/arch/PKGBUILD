# Maintainer: everybodydies
pkgname=rtify
pkgver=0.6.0
pkgrel=1
pkgdesc="Spotify client with a built-in Connect player: System24/OLED look, tray, global shortcuts, animated lyrics"
arch=('x86_64')
url="https://github.com/everybodydies/rtify"
license=('GPL-3.0-or-later' 'OFL-1.1')
depends=('gtk4' 'dbus' 'gcc-libs' 'glibc' 'libpulse')
makedepends=('cargo')
optdepends=(
  'pipewire-pulse: sound for the built-in player on PipeWire desktops (or PulseAudio)'
  'xdg-desktop-portal-hyprland: global shortcuts on Hyprland'
  'gnome-keyring: Secret Service for the Spotify login (or KWallet / KeePassXC)'
  'noto-fonts-cjk: Japanese, Korean and Chinese lyrics'
)
# packaging/arch/build.sh creates this tarball from the checkout.
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')
options=('!lto' '!debug')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo test --frozen --release --lib
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/rtify "$pkgdir/usr/bin/rtify"
  install -Dm644 data/io.github.everybodydies.rtify.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 data/io.github.everybodydies.rtify.metainfo.xml -t "$pkgdir/usr/share/metainfo"
  install -Dm644 data/icons/io.github.everybodydies.rtify.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
  install -Dm644 data/noctalia/rtify.css data/noctalia/templates.toml -t "$pkgdir/usr/share/rtify/noctalia"
  install -Dm644 README.md CHANGELOG.md DESIGN.md -t "$pkgdir/usr/share/doc/rtify"
  install -Dm644 data/fonts/OFL.txt "$pkgdir/usr/share/licenses/rtify/DM-Mono-OFL.txt"
}
