# Maintainer: everybodydies
pkgname=rtify
pkgver=0.1.0
pkgrel=1
pkgdesc="Spotify Connect companion: System24 look, tray, global shortcuts, animated lyrics"
arch=('x86_64' 'aarch64')
url="https://github.com/everybodydies/rtify"
license=('GPL-3.0-or-later')
depends=('gtk4' 'dbus')
makedepends=('cargo' 'git')
optdepends=(
  'xdg-desktop-portal-hyprland: global shortcuts on Hyprland'
  'gnome-keyring: Secret Service for the Spotify login (or KWallet / KeePassXC)'
  'ttf-jetbrains-mono: default interface font'
  'noto-fonts-cjk: Japanese, Korean and Chinese lyrics'
)
source=("$pkgname::git+file://$(realpath "${startdir}/../..")")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname"
  cargo test --frozen --lib
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/rtify "$pkgdir/usr/bin/rtify"
  install -Dm644 data/io.github.everybodydies.rtify.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 data/icons/io.github.everybodydies.rtify.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
  install -Dm644 data/noctalia/rtify.css -t "$pkgdir/usr/share/rtify/noctalia"
  install -Dm644 data/noctalia/templates.toml -t "$pkgdir/usr/share/rtify/noctalia"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/rtify"
}
